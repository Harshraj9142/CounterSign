# Copy to .env and fill in. Everything is optional: with no PayPal credentials,
# Countersign runs fully offline against a built-in PayPal mock.

# --- PayPal ------------------------------------------------------------------
# developer.paypal.com → Apps & Credentials → (Sandbox) your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# mock | sandbox | live. Defaults to sandbox when a client ID is set.
# live additionally requires ALLOW_LIVE=true (don't, for the hackathon).
PAYPAL_MODE=
# Sandbox PERSONAL account emails that receive demo payouts, comma-separated.
# Run `npm run seed` after changing this.
SANDBOX_RECIPIENTS=
# From `npm run sandbox:webhook` (needs a public HTTPS PUBLIC_URL). Optional:
# without it Countersign polls PayPal for status every 20 seconds.
PAYPAL_WEBHOOK_ID=

# --- Server --------------------------------------------------------------------
PORT=3000
HOST=127.0.0.1
# Public base URL used in links and webhooks (Render sets RENDER_EXTERNAL_URL itself).
PUBLIC_URL=
# Protect the dashboard and the /mcp endpoint when hosted. Leave empty locally.
DASHBOARD_TOKEN=
MCP_TOKEN=
# Key that signs the spending mandate. If empty, one is generated in DATA_DIR/.mandate-key.
MANDATE_SIGNING_KEY=
DATA_DIR=data
BUSINESS_NAME=Larkspur Studio
# Seed the demo story on first start, and show a "Reset demo" button.
SEED_ON_START=true
DEMO_MODE=true
