{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build && mkdir -p vercel-static",
  "outputDirectory": "vercel-static",
  "functions": {
    "api/index.js": { "includeFiles": "public/**" }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api" }]
}
